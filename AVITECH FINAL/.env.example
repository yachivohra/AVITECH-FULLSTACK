# Copy these into your hosting provider's Variables panel.
# Do not commit real values or passwords.
AVITECH_SECRET_KEY=replace-with-a-long-random-secret
AVITECH_DB_HOST=your-managed-mysql-host
AVITECH_DB_PORT=3306
AVITECH_DB_USER=your-mysql-user
AVITECH_DB_PASSWORD=your-mysql-password
AVITECH_DB_NAME=your-mysql-database
# Optional: designate an administrator email for registration
AVITECH_ADMIN_EMAIL=admin@example.com
